[Unit]
Description=Circumspectio daily preparation and SendGrid scheduling
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
Type=oneshot
User=circumspectio
Group=circumspectio
WorkingDirectory=/opt/circumspectio
EnvironmentFile=/etc/circumspectio.env
ExecStart=/opt/circumspectio/.venv/bin/python daily.py --live
TimeoutStartSec=40min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/circumspectio/out
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MPLCONFIGDIR=/tmp/circumspectio-matplotlib
StandardOutput=journal
StandardError=journal
