# Copy to /etc/circumspectio.env, owner root, group root, mode 0600.
# Never commit real credentials. systemd reads the file before dropping privileges.
GITHUB_REPOSITORY=theodorklink/circumspectio
# Fine-grained token restricted to this repo, Contents read/write. Rotate it.
GITHUB_TOKEN=
ANTHROPIC_API_KEY=
SENDGRID_API_KEY=
MAIL_FROM=
MAIL_TO=
SEND_HOUR=7
SENDGRID_API_HOST=https://api.sendgrid.com
