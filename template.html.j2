{#- Circumspectio – E-Mail-Template. Inline-Styles, Tabellenlayout (Outlook/Gmail-tauglich). -#}
{%- set serif = "font-family:'Times New Roman',Times,'Liberation Serif',Georgia,serif;" -%}
{%- set ink = "#1B1B1B" -%}{%- set muted = "#5F6670" -%}{%- set rule = "#D5D8DD" -%}
{%- set accent = "#1F3A5F" -%}{%- set tint = "#F2F4F7" -%}
{%- set p_body = serif ~ "font-size:17px;line-height:1.6;color:" ~ ink ~ ";margin:0 0 14px 0;" -%}
{%- set h_sec = serif ~ "font-size:26px;line-height:1.2;font-weight:normal;color:" ~ ink ~ ";margin:0;padding:28px 0 6px 0;border-top:2px solid " ~ ink ~ ";" -%}
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>{{ titel }} | {{ datum }}</title>
<style>
  body { margin:0; padding:0; background:#E9EBEE; }
  a { color:{{ accent }}; }
  @media (max-width: 660px) {
    .wrap { width:100% !important; }
    .pad { padding-left:20px !important; padding-right:20px !important; }
    .kopf { font-size:38px !important; }
    .seite { display:none !important; }
  }
</style>
</head>
<body style="margin:0;padding:0;background:#E9EBEE;">
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">{{ d.lage_in_einem_satz }}</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#E9EBEE;">
<tr><td align="center" style="padding:24px 8px;">
<table role="presentation" class="wrap" width="640" cellpadding="0" cellspacing="0" border="0" style="width:640px;max-width:640px;background:#FFFFFF;">

<!-- Kopf -->
<tr><td class="pad" style="padding:30px 32px 0 32px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td style="{{ serif }}font-size:14px;color:{{ muted }};font-style:italic;">{{ datum }}</td>
      <td class="seite" align="right" style="{{ serif }}font-size:14px;color:{{ muted }};font-style:italic;">Berlin, Stand {{ uhrzeit }} Uhr</td>
    </tr>
  </table>
  <div class="kopf" style="{{ serif }}font-size:50px;line-height:1.05;color:{{ ink }};padding:10px 0 12px 0;">{{ titel }}</div>
  <div style="border-top:4px double {{ ink }};height:0;line-height:0;font-size:0;">&nbsp;</div>
  {% if d.lage_in_einem_satz %}
  <p style="{{ serif }}font-size:21px;line-height:1.45;font-style:italic;color:{{ ink }};margin:18px 0 6px 0;">{{ d.lage_in_einem_satz }}</p>
  {% endif %}
</td></tr>

<!-- Die Meldungen -->
<tr><td class="pad" style="padding:8px 32px 0 32px;">
  <h2 style="{{ h_sec }}">Die Meldungen</h2>
  {% for region, items in gruppen %}
  <div style="{{ serif }}font-size:17px;font-style:italic;color:{{ accent }};padding:14px 0 2px 0;">{{ region }}</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    {% for s in items %}
    <tr><td style="padding:10px 0 11px 0;border-top:1px solid {{ rule }};">
      <div style="{{ serif }}font-size:18px;line-height:1.35;font-weight:bold;color:{{ ink }};">
        {% if s.link %}<a href="{{ s.link }}" style="color:{{ ink }};text-decoration:none;">{{ s.titel }}</a>{% else %}{{ s.titel }}{% endif %}
      </div>
      <div style="{{ serif }}font-size:16px;line-height:1.5;color:#2B2B2B;padding-top:3px;">
        {{ s.kurz }}{% if s.link %} <a href="{{ s.link }}" style="color:{{ accent }};font-style:italic;">{{ s.quelle or "zum Artikel" }}</a>{% endif %}
      </div>
    </td></tr>
    {% endfor %}
  </table>
  {% endfor %}
</td></tr>

<!-- Hintergrund -->
{% if d.hintergrund %}
<tr><td class="pad" style="padding:22px 32px 0 32px;">
  <h2 style="{{ h_sec }}">Hintergrund</h2>
</td></tr>
{% for h in d.hintergrund %}
<tr><td class="pad" style="padding:16px 32px 6px 32px;">
  {% if h.dachzeile %}<div style="{{ serif }}font-size:15px;font-style:italic;color:{{ muted }};padding-bottom:4px;">{{ h.dachzeile }}</div>{% endif %}
  <div style="{{ serif }}font-size:25px;line-height:1.22;font-weight:bold;color:{{ ink }};padding-bottom:12px;">{{ h.titel }}</div>

  {% if h.bild %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 16px 0;">
    <tr><td align="center">
      <img src="{{ src(h.bild.cid) }}" width="{{ 300 if h.bild.hoch else 576 }}" alt="{{ h.bild.unterschrift or h.bild.artikel }}"
           style="display:block;width:{{ 300 if h.bild.hoch else 576 }}px;max-width:100%;height:auto;border:0;">
    </td></tr>
    <tr><td align="{{ 'center' if h.bild.hoch else 'left' }}" style="{{ serif }}font-size:13px;line-height:1.4;color:{{ muted }};padding-top:6px;">
      {{ h.bild.unterschrift }} <span style="font-style:italic;">Bild: <a href="{{ h.bild.seite }}" style="color:{{ muted }};">Wikimedia Commons / Wikipedia</a></span>
    </td></tr>
  </table>
  {% endif %}

  {{ h.text | absaetze(p_body) }}

  {% if h.diagramm_cid %}
  <img src="{{ src(h.diagramm_cid) }}" width="576" alt="{{ h.diagramm.titel }}"
       style="display:block;width:576px;max-width:100%;height:auto;border:0;margin:4px 0 18px 0;">
  {% endif %}

  {% if h.hinter_den_kulissen %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:4px 0 14px 0;">
    <tr><td style="background:{{ tint }};border-left:3px solid {{ accent }};padding:14px 18px 2px 18px;">
      <div style="{{ serif }}font-size:16px;font-weight:bold;color:{{ accent }};padding-bottom:6px;">Hinter den Kulissen</div>
      {{ h.hinter_den_kulissen | absaetze(serif ~ "font-size:16px;line-height:1.55;color:" ~ ink ~ ";margin:0 0 12px 0;") }}
    </td></tr>
  </table>
  {% endif %}

  {% if h.akteure and h.akteure.akteure %}
  <div style="{{ serif }}font-size:16px;font-weight:bold;color:{{ ink }};padding:6px 0 6px 0;">{{ h.akteure.titel or "Wer will was?" }}</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid {{ ink }};margin-bottom:16px;">
    {% for a in h.akteure.akteure %}
    <tr>
      <td width="30%" valign="top" style="{{ serif }}font-size:15px;line-height:1.4;font-weight:bold;color:{{ ink }};padding:8px 10px 8px 0;border-bottom:1px solid {{ rule }};">{{ a.name }}</td>
      <td valign="top" style="{{ serif }}font-size:15px;line-height:1.45;color:{{ ink }};padding:8px 0;border-bottom:1px solid {{ rule }};">
        {{ a.position }}{% if a.interesse %}<br><span style="color:{{ muted }};font-style:italic;">Interesse: {{ a.interesse }}</span>{% endif %}
      </td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}

  {% if h.worauf_achten %}
  <p style="{{ serif }}font-size:16px;line-height:1.5;color:{{ ink }};margin:0 0 12px 0;"><span style="font-style:italic;color:{{ accent }};">Worauf zu achten ist:</span> {{ h.worauf_achten }}</p>
  {% endif %}

  {% if h.links %}
  <p style="{{ serif }}font-size:15px;line-height:1.6;color:{{ muted }};margin:0 0 10px 0;">
    Weiterlesen:
    {% for l in h.links %}<a href="{{ l.url }}" style="color:{{ accent }};">{{ l.quelle }}{% if l.titel %}, {{ l.titel }}{% endif %}</a>{% if not loop.last %}; {% endif %}{% endfor %}
  </p>
  {% endif %}
  {% if not loop.last %}<div style="border-top:1px solid {{ rule }};height:0;line-height:0;font-size:0;margin-top:14px;">&nbsp;</div>{% endif %}
</td></tr>
{% endfor %}
{% endif %}

<!-- Am Horizont -->
{% if d.am_horizont %}
<tr><td class="pad" style="padding:22px 32px 0 32px;">
  <h2 style="{{ h_sec }}">Am Horizont</h2>
  <p style="{{ serif }}font-size:15px;font-style:italic;color:{{ muted }};margin:4px 0 4px 0;">Was sich abzeichnet. Die Kästchen zeigen, wie deutlich das Signal ist.</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    {% for r in d.am_horizont %}
    <tr>
      <td width="46" valign="top" style="{{ serif }}font-size:13px;letter-spacing:1px;color:{{ accent }};padding:13px 0 0 0;border-top:1px solid {{ rule }};">{% for i in range(3) %}{{ "&#9632;"|safe if i < r.signal else "&#9633;"|safe }}{% endfor %}</td>
      <td valign="top" style="padding:10px 0 11px 0;border-top:1px solid {{ rule }};">
        <div style="{{ serif }}font-size:17px;line-height:1.35;font-weight:bold;color:{{ ink }};">{% if r.link %}<a href="{{ r.link }}" style="color:{{ ink }};text-decoration:none;">{{ r.titel }}</a>{% else %}{{ r.titel }}{% endif %}</div>
        <div style="{{ serif }}font-size:16px;line-height:1.5;color:#2B2B2B;padding-top:3px;">{{ r.text }}</div>
      </td>
    </tr>
    {% endfor %}
  </table>
</td></tr>
{% endif %}

<!-- Termine -->
{% if d.termine %}
<tr><td class="pad" style="padding:22px 32px 0 32px;">
  <h2 style="{{ h_sec }}">Termine</h2>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    {% for t in d.termine %}
    <tr>
      <td width="34%" valign="top" style="{{ serif }}font-size:15px;font-style:italic;color:{{ muted }};padding:8px 10px 8px 0;border-top:1px solid {{ rule }};">{{ t.wann }}</td>
      <td valign="top" style="{{ serif }}font-size:16px;line-height:1.45;color:{{ ink }};padding:8px 0;border-top:1px solid {{ rule }};">{{ t.was }}</td>
    </tr>
    {% endfor %}
  </table>
</td></tr>
{% endif %}

<!-- Zum Hören -->
{% if d.hoertipps %}
<tr><td class="pad" style="padding:22px 32px 0 32px;">
  <h2 style="{{ h_sec }}">Zum Hören</h2>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    {% for p in d.hoertipps %}
    <tr>
      <td width="30" valign="top" style="font-size:16px;color:{{ accent }};padding:11px 0 0 0;border-top:1px solid {{ rule }};">&#9654;</td>
      <td valign="top" style="padding:10px 0 11px 0;border-top:1px solid {{ rule }};">
        <div style="{{ serif }}font-size:14px;font-style:italic;color:{{ muted }};">{{ p.sendung }}{% if p.dauer %}, {{ p.dauer }}{% endif %}</div>
        <div style="{{ serif }}font-size:17px;line-height:1.35;font-weight:bold;"><a href="{{ p.url }}" style="color:{{ ink }};text-decoration:none;">{{ p.titel }}</a></div>
        {% if p.beschreibung %}<div style="{{ serif }}font-size:15px;line-height:1.45;color:#2B2B2B;padding-top:2px;">{{ p.beschreibung }}</div>{% endif %}
      </td>
    </tr>
    {% endfor %}
  </table>
</td></tr>
{% endif %}

<!-- Zitat -->
{% if d.zitat and d.zitat.text %}
<tr><td class="pad" style="padding:30px 32px 0 32px;">
  <div style="border-top:2px solid {{ ink }};padding-top:22px;">
    <p style="{{ serif }}font-size:23px;line-height:1.4;font-style:italic;color:{{ ink }};margin:0 0 8px 0;">&bdquo;{{ d.zitat.text }}&ldquo;</p>
    <p style="{{ serif }}font-size:15px;line-height:1.45;color:{{ muted }};margin:0;">
      {% if d.zitat.url %}<a href="{{ d.zitat.url }}" style="color:{{ muted }};">{{ d.zitat.person }}</a>{% else %}{{ d.zitat.person }}{% endif %}{% if d.zitat.kontext %}, {{ d.zitat.kontext }}{% endif %}
    </p>
  </div>
</td></tr>
{% endif %}

<!-- Fuß -->
<tr><td class="pad" style="padding:34px 32px 30px 32px;">
  <div style="border-top:1px solid {{ rule }};padding-top:14px;{{ serif }}font-size:13px;line-height:1.5;color:{{ muted }};">
    Recherchiert und verfasst von Claude ({{ modell }}) aus öffentlich zugänglichen Quellen. Einordnungen und Lesarten sind maschinell erstellt und können Fehler enthalten; vor Entscheidungen bitte die verlinkten Originalquellen prüfen. Bilder über Wikipedia / Wikimedia Commons, Lizenzangaben auf den verlinkten Seiten.
  </div>
</td></tr>

</table>
</td></tr>
</table>
</body>
</html>
